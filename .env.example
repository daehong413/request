# 실제 배포할 도메인 원점. 경로 없이 입력하고 변경 후 다시 빌드하세요.
# 설정 전에는 검색 수집을 막고 사이트맵을 비워 둡니다.
SITE_URL=https://kmwindow.com

# 검색엔진 소유 확인: 발급된 메타태그의 content 값만 입력 (태그 전체 X)
# 값을 변경하면 다시 빌드/배포하세요. 이 값은 페이지 HTML에 공개됩니다.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# 다우오피스 발신 계정 (서버 전용, NEXT_PUBLIC_ 접두사 사용 금지)
DAOU_SMTP_USER=
DAOU_SMTP_PASSWORD=
# 비워두면 lib/site-config.ts의 이메일로 수신합니다.
CONTACT_EMAIL_TO=
